# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
# Phase 3A static export output (scripts/prerender-static.mjs), a plain
# folder of static files, not a build cache. Kept out of git the same way
# dist/.output are: regenerated by `npm run build:static`, never hand-edited.
dist-static
# Zipped copy of dist-static's contents, for uploading to Hostinger. Same
# reasoning as dist-static itself: a build artifact, regenerated on demand,
# never hand-edited, and it would carry PHPMailer's vendored files and
# every page's HTML into git for no reason if it were tracked.
/tutormunk-site.zip
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local environment files. Never commit real secrets. .env.example may be
# committed on purpose as a template with placeholder values only.
.env
.env.*
!.env.example

# The real Titan mailbox password for send.php. Never committed.
# deploy/php/mail.config.example.php is the template that DOES ship,
# copy it to mail.config.php by hand (locally and on the server) and fill
# in smtp_pass there. Confirmed with `git check-ignore deploy/php/mail.config.php`.
deploy/php/mail.config.php

# send.php's log and rate-limit file, created one level above wherever it
# runs from (mirrors "one level above public_html" on Hostinger). When
# tested locally with `php -S -t dist-static`, that lands at the repo root.
/mail-data/

# OS generated files. .DS_Store is already listed above under editor files.
Thumbs.db
ehthumbs.db
Desktop.ini

# Local tool settings, per machine, not shared. Written by the coding
# assistant and re-created automatically, so it never needs committing.
.claude/settings.local.json
