# ==========================================================================
# TutorMunk .htaccess — Apache configuration for the Hostinger deployment
# (tutormunk.com.au)
#
# Plain-language guide: each numbered block below does ONE job. Read the
# comment above a block before changing anything inside it. If something
# on the live site looks broken after an edit here, the fastest fix is to
# revert this file to the last known-good version.
# ==========================================================================

# --------------------------------------------------------------------------
# 1) FORCE HTTPS
# Sends visitors from the http:// version of a page to the https:// version
# of the same page, so nobody browses the site unencrypted.
# --------------------------------------------------------------------------
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --------------------------------------------------------------------------
# 2) CANONICAL DOMAIN
# Redirects every domain variant that might point at this hosting account
# (www.tutormunk.com.au, or anything else) to the one address we want
# Google and visitors to use: https://tutormunk.com.au (no www).
# --------------------------------------------------------------------------
RewriteCond %{HTTP_HOST} !^tutormunk\.com\.au$ [NC]
RewriteRule ^(.*)$ https://tutormunk.com.au/$1 [L,R=301]

# --------------------------------------------------------------------------
# 3) NO TRAILING SLASH ON PAGE URLS
# Every page in this build is a folder with its own index.html inside (for
# example primary-school/index.html), and every canonical tag on the site
# is written WITHOUT a trailing slash, e.g.
# https://tutormunk.com.au/primary-school. Apache's own default behaviour
# for a URL that maps to a folder is the opposite: it 301-redirects
# /primary-school to /primary-school/ before even looking for the index
# file inside (this is mod_dir's "DirectorySlash" setting, on by default).
# Left on, every page would have two live addresses, with and without the
# slash, exactly what the canonical tag says should not be true.
#
# Fixing that takes two parts, and both are needed together:
#   1. DirectorySlash Off turns off Apache's own automatic redirect, so
#      requesting /primary-school no longer gets bounced to add a slash.
#   2. With that automatic behaviour off, Apache also stops automatically
#      finding the index file inside the folder on its own, so the second
#      RewriteRule below does that part by hand: for a request that is not
#      already a real file, and does resolve to a real folder containing
#      an index.html, it serves that index.html WITHOUT changing the URL
#      the browser or Google sees (an internal rewrite, not a redirect).
#      /primary-school stays /primary-school in the address bar and in
#      search results, it is just quietly served from
#      primary-school/index.html underneath.
#
# The first RewriteRule below handles the other direction: anyone who does
# land on a URL WITH a trailing slash (an old link, a typo, a leftover
# from before this block existed) is permanently redirected to the
# slash-less canonical form, so there is exactly one live address per page
# either way.
#
# Both rules deliberately leave alone: the root "/" (it has no "other"
# form to redirect to or rewrite), and anything with a dot in its last
# path segment, i.e. a real file such as .css, .js, .png, .xml or .php.
# That last exclusion is what keeps /send.php (and every static asset)
# untouched by any of this, on top of the "is this already a real file"
# check each rule also makes.
# --------------------------------------------------------------------------
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# Redirect: /page/ -> /page (skips "/" itself, and only for a real folder)
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{DOCUMENT_ROOT}/$1 -d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Internal rewrite: /page -> serves page/index.html, URL stays /page
RewriteCond %{REQUEST_URI} !\.[^/]+$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ $1/index.html [L]

# --------------------------------------------------------------------------
# 4) CUSTOM 404 PAGE
# Tells Apache which page to show a visitor who lands on a URL that
# doesn't exist (a mistyped suburb page, an old removed link, etc).
# NOTE: 404.html itself is not part of this repo yet. It's produced later,
# alongside every other page, by the static-site (SSG) build. Until that
# build exists and is deployed, leave this line in but be aware the file
# it points to won't be there, Apache will fall back to its own default
# error page if 404.html is missing.
# --------------------------------------------------------------------------
ErrorDocument 404 /404.html

# --------------------------------------------------------------------------
# 5) LONG-LIVED CACHING FOR STATIC FILES
# Tells visitors' browsers to keep images, fonts, CSS and JS for a good
# while before checking back with the server. Makes repeat visits to the
# site noticeably faster. Filenames for CSS/JS are expected to change
# (via a build hash) whenever we ship new code, so a long cache here is
# safe, visitors won't get stuck on an old version.
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# --------------------------------------------------------------------------
# 6) COMPRESSION
# Shrinks text-based files (HTML, CSS, JS, JSON, SVG) before sending them
# over the network, so pages load faster, especially on mobile data.
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --------------------------------------------------------------------------
# 7) SECURITY HEADERS
# Four standard protections against common web attacks. These are response
# headers, so they do not interact with the redirect rules in blocks 1 and
# 2. Those run first, and this block stamps the headers onto whatever
# response comes out the other side.
#
# Strict-Transport-Security (HSTS) tells a browser to only ever reach this
# site over https for the next year, so a visitor cannot be downgraded to
# an unencrypted connection. It has no effect on plain http responses,
# browsers ignore it there, which is exactly why block 1 above matters.
#
# X-Frame-Options SAMEORIGIN stops another website from loading TutorMunk
# inside a hidden frame on their own page and tricking a visitor into
# clicking something they cannot see (clickjacking).
#
# X-Content-Type-Options nosniff stops a browser from guessing that a file
# is something other than what the server said it was, which is a common
# route to getting an uploaded file executed as a script.
#
# "always" is used so the headers are sent on error responses too, not
# only on successful ones.
#
# WARNING about the preload keyword: it is a request to be added to a list
# baked into browsers themselves. Once tutormunk.com.au is actually
# SUBMITTED to that list, every subdomain must serve valid https, and
# getting removed again takes months. The header sitting here does nothing
# on its own, submission is a separate manual step. Do not submit the
# domain until the site is live and every subdomain is on https.
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# --------------------------------------------------------------------------
# 8) DIRECTORY LISTING OFF
# Stops Apache from showing a browsable list of files when someone visits a
# folder that has no index page, for example /images/blog/. Without this,
# anyone can read the entire contents of an asset folder just by guessing
# the folder name. Declared once at the top level, so it applies to this
# directory and every folder beneath it, including all asset paths.
#
# NOTE: if the host does not permit Options in .htaccess (AllowOverride
# set too tightly), Apache returns a 500 error for every page. If the site
# goes blank right after deploying this file, comment out the Options line
# below first, that is the most likely cause.
# --------------------------------------------------------------------------
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# --------------------------------------------------------------------------
# 9) SPA FALLBACK — TEMPORARY TESTING ONLY, DISABLED BY DEFAULT
# This block is commented out on purpose. It is ONLY needed if we ever
# deploy the current client-side React build (before the SSG conversion)
# somewhere for a temporary test, where every URL needs to fall back to
# index.html so the in-browser router can take over.
#
# Once the SSG conversion ships, every page (including all 23 suburb
# pages) is its own real static HTML file at its own real URL, and this
# fallback must stay OFF, turning it on would hide real 404s behind a
# blank or wrong page. Uncomment only for a short-lived SPA test, then
# remove it again before the real launch.
# --------------------------------------------------------------------------
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule ^ index.html [L]

# --------------------------------------------------------------------------
# 10) DENY ACCESS TO DOTFILES
# Blocks web access to any file whose name starts with a dot, for example
# .ftp-deploy-sync-state.json (a bookkeeping file the GitHub Actions
# deploy writes into public_html to track what it has already uploaded)
# and .htaccess itself. None of these are meant to be requested directly
# by a browser, and the sync-state file in particular has no reason to be
# world-readable.
#
# Two versions of the same rule, because Apache's access-control syntax
# changed in 2.4: "Require all denied" is the modern (2.4+) directive,
# inside mod_authz_core. The Order/Deny fallback is the older Apache
# 2.2-style equivalent, in case Hostinger is ever running that instead.
# Only one of the two <IfModule> blocks actually applies on any given
# server, the other is silently skipped.
# --------------------------------------------------------------------------
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
